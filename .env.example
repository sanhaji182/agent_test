# Environment
APP_ENV=development       # development | production — production requires API_KEY
APP_PORT=8080
API_KEY=                  # empty = no auth (development only)

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/gotest_agent?sslmode=disable

# Redis (optional durable queue — set QUEUE_ENABLED=true to activate; see ADR-001)
REDIS_URL=localhost:6379
# QUEUE_ENABLED=true   # route run execution through Redis/Asynq worker; default = in-process goroutines

# LLM — Primary
ANTHROPIC_API_KEY=sk-ant-xxxx
LLM_MODEL=claude-sonnet-4-5

# LLM — Multi-Provider (code-consumed; omit from default Compose)
# LLM_PROVIDER=anthropic     # anthropic | openai | google | deepseek | custom | local
# LLM_API_KEY=
# LLM_BASE_URL=

# LLM — OpenAI (used by ai.Client when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxx

# Feature Flags (code-consumed; optional)
# GOTEST_AI_PLANNING=1           # enable AI feature extraction and plan generation
# GOTEST_APPROVED_CASE_RUNNER=docker  # enable real Docker Playwright for approved cases

# Steel Browser (client exists; unwired in primary web path — see ADR-002)
STEEL_API_URL=http://localhost:3000
STEEL_API_KEY=

# LangGraph Sidecar (unwired from primary web path)
LANGGRAPH_URL=http://localhost:8000

# Storage
SCREENSHOTS_PATH=./data/screenshots
REPORTS_PATH=./data/reports

# JWT Secret for dashboard cookie auth (see TODO-005)
# If unset, a random secret is generated at startup (valid for current process only).
# Set for persistent sessions across server restarts.
JWT_SECRET=

# GitHub webhook HMAC verification secret
GITHUB_WEBHOOK_SECRET=

# The following are declared in documentation but have no runtime consumer at this revision.
# They are kept for reference until deployment intent is confirmed.
# UNUSED: BRAINTRUST_API_KEY VISION_MODEL
# UNUSED: MAX_FIX_ATTEMPTS DEFAULT_TIMEOUT_SECONDS STEEL_MAX_SESSIONS
# UNUSED: ENABLE_VISUAL_REGRESSION ENABLE_ADVANCED_AGENT GOOGLE_API_KEY DEEPSEEK_API_KEY
